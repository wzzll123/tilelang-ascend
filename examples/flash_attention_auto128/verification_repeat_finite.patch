+        if (torch.is_floating_point(value) or torch.is_complex(value)) and not torch.isfinite(value).all().item():
+            raise ValueError(f"{path}: candidate output contains NaN or infinity")
+    elif isinstance(value, (list, tuple)):
+        for index, item in enumerate(value):
